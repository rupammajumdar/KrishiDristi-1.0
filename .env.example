# Environment Configuration for KrishiDrishti AI
# Copy this file to .env and fill in your values

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://krishidristi:krishidristi_secret@localhost:5432/krishidristi_db
DATABASE_URL_SYNC=postgresql://krishidristi:krishidristi_secret@localhost:5432/krishidristi_db
POSTGRES_USER=krishidristi
POSTGRES_PASSWORD=krishidristi_secret
POSTGRES_DB=krishidristi_db

# ============ REDIS ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ JWT AUTH ============
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ EXTERNAL APIs (optional — demo mode works without these) ============
# Mapbox (for premium map tiles — Leaflet/OSM used as free fallback)
MAPBOX_ACCESS_TOKEN=

# Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=

# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# OpenWeather API
OPENWEATHER_API_KEY=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============ APP CONFIG ============
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true
DEFAULT_LANGUAGE=en

# ============ SATELLITE CONFIG ============
CLOUD_COVER_THRESHOLD=20
SENTINEL2_REVISIT_DAYS=5
NDVI_GREEN_THRESHOLD=0.6
NDVI_YELLOW_THRESHOLD=0.3
EARLY_WARNING_YIELD_DROP_PCT=20
ALERT_COOLDOWN_DAYS=5
